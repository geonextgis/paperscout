# Copy to `.env` for LOCAL pipeline runs (`npm run fetch-papers`).
# `.env` is git-ignored. In production these values come from GitHub
# repository secrets/variables (Settings → Secrets and variables → Actions).
# None of these are ever bundled into the frontend.

# --- Web of Science (secret) -------------------------------------------------
# Web of Science Starter API key from https://developer.clarivate.com/apis/wos-starter
# Leave empty to skip Web of Science; the pipeline continues with other sources.
WOS_API_KEY=
# Maximum number of WoS requests per pipeline run. The free "Starter" plan
# allows 50 requests/day; institutional plans allow 5,000–20,000/day.
WOS_MAX_REQUESTS=40
# Requests per second (free plan: 1, institutional: 5).
WOS_REQUESTS_PER_SECOND=1

# --- Semantic Scholar (secret, optional) -------------------------------------
# Works without a key via the shared, heavily throttled public pool.
SEMANTIC_SCHOLAR_API_KEY=

# --- Crossref (variable, optional but recommended) ---------------------------
# Contact email → Crossref "polite pool" (faster, more reliable). Not a secret.
CROSSREF_MAILTO=
