{
  "name": "paperscout",
  "private": true,
  "version": "0.1.0",
  "description": "Personalized scientific literature discovery — static site on GitHub Pages, catalogue built by GitHub Actions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
